# Maestro reads the server process environment; it does not load .env files.
# Keep personal values and credentials outside the tracked checkout.

# Blank uses the OS per-user data directory. Must resolve outside the checkout.
MAESTRO_DATA_DIR=

# Optional public-source archive, separate from the private data/index directory.
# Set an absolute path outside the checkout and MAESTRO_DATA_DIR in the server
# environment, then restart. Source saving is enabled separately in Settings.
# Example: C:\Users\you\OneDrive\Maestro-SearchArchive
MAESTRO_CONTEXT_ARCHIVE_DIR=

# Native port: -Port overrides this value; blank defaults to 8765.
# Use 0 for an OS-assigned port. The native launcher prints the actual URL,
# sets MAESTRO_PORT in its PowerShell session and records it in server.json.
# Vite needs the actual listening port (1-65535); start the backend first.
# The container launcher sets its published port separately.
MAESTRO_PORT=8765
MAESTRO_TIMEZONE=Europe/Stockholm

# Ollama endpoint default / exact trusted container host endpoint.
# Blank keeps native loopback-only Ollama. Saved provider addresses in Settings
# remain authoritative; changing Maestro's port does not change Ollama or tunnels.
MAESTRO_OLLAMA_URL=

# Optional read-only secret files, mounted outside the image/checkout.
# The provider file is scoped to this exact endpoint; never enter a key here.
MAESTRO_API_KEY_FILE=
MAESTRO_API_KEY_URL=https://api.openai.com/v1
MAESTRO_SEARCH_KEY_FILE=

# Optional server-environment fallback for the OpenAI endpoint.
# Model selection and pricing are configured in local Settings.
# Windows Credential Manager or session-only keys can be used instead.
OPENAI_API_KEY=
