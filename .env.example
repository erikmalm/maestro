# Proposed configuration names. The preview does not load .env files.
# Set MAESTRO_DATA_DIR/MAESTRO_TIMEZONE in the server environment if needed.
# Keep this tracked example blank of credentials and personal information.
# Everyday setup will use local Settings and the OS credential store.
MAESTRO_HOST=127.0.0.1
MAESTRO_PORT=8765
MAESTRO_TIMEZONE=Europe/Stockholm

# Blank means the OS per-user data directory; must be outside the Git checkout.
MAESTRO_DATA_DIR=

# Reflection reads OPENAI_API_KEY from the server process environment only.
# Select its model and verified pricing through the private local Reflection UI.
MAESTRO_PROVIDER=openai
OPENAI_MODEL=
OPENAI_API_KEY=

# Proposed conservative limits; all descendants share each run's allowance.
MAESTRO_AUTO_RUN=false
MAESTRO_RUN_BUDGET_USD=1.00
MAESTRO_DAILY_BUDGET_USD=5.00
MAESTRO_MONTHLY_BUDGET_USD=50.00
MAESTRO_MAX_REVIEW_CYCLES=3
MAESTRO_MAX_DELEGATION_DEPTH=2
MAESTRO_MAX_AGENT_EXECUTIONS=6
MAESTRO_MAX_CONCURRENT_AGENTS=2
MAESTRO_MAX_MODEL_CALLS=20
MAESTRO_MAX_RUN_TOKENS=100000
MAESTRO_MAX_INPUT_TOKENS_PER_CALL=8000
MAESTRO_MAX_OUTPUT_TOKENS_PER_CALL=2000
MAESTRO_MAX_TOOL_CALLS=30
MAESTRO_MAX_RUN_SECONDS=600
MAESTRO_MAX_TRANSIENT_RETRIES=2
